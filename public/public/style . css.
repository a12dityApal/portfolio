:root { --paper:#eef2f7; --grid:#d3dcea; --ink:#14213d; --muted:#55657d; --blue:#2f5bea; --marker:#ffd23f; --card:#fff; --radius:6px; }
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0; font-family: "IBM Plex Sans", system-ui, sans-serif; color: var(--ink); line-height: 1.65;
  background-color: var(--paper);
  background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
  background-size: 32px 32px;
}
h1, h2, h3, .brand { font-family: "Bricolage Grotesque", system-ui, sans-serif; line-height: 1.1; margin: 0; }
a { color: var(--blue); }
:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }
.nav { position: sticky; top: 0; z-index: 10; display: flex; justify-content: space-between; align-items: center; padding: 14px clamp(20px,5vw,64px); background: rgba(238,242,247,.92); border-bottom: 1px solid var(--grid); }
.brand { font-weight: 800; font-size: 1.3rem; color: var(--ink); text-decoration: none; }
.nav nav { display: flex; gap: 22px; }
.nav nav a { color: var(--ink); text-decoration: none; font-weight: 500; }
.nav nav a:hover { color: var(--blue); }
main { max-width: 1040px; margin: 0 auto; padding: 0 clamp(20px,5vw,40px); }
.hero { padding: clamp(56px,12vw,130px) 0 clamp(48px,8vw,90px); }
.hero-kicker { margin: 0 0 18px; color: var(--muted); }
.hero h1 {
  font-weight: 800; font-size: clamp(2.4rem,7.2vw,5rem); letter-spacing: -.03em; max-width: 15ch;
  background: linear-gradient(transparent 62%, var(--marker) 62%, var(--marker) 92%, transparent 92%);
  background-repeat: no-repeat; background-size: 0% 100%; animation: mark 900ms 300ms ease-out forwards;
  display: inline; box-decoration-break: clone; -webkit-box-decoration-break: clone;
}
@keyframes mark { to { background-size: 100% 100%; } }
.dimension { display: flex; align-items: center; gap: 10px; margin: 34px 0 30px; max-width: 560px; color: var(--muted); font-size: .95rem; }
.dimension span { flex: 1; height: 1px; background: var(--muted); position: relative; }
.dimension span::before, .dimension span:last-child::after { content: ""; position: absolute; top: -5px; width: 1px; height: 11px; background: var(--muted); }
.dimension span:first-child::before { left: 0; }
.dimension span:last-child::before { display: none; }
.dimension span:last-child::after { right: 0; }
.dimension em { font-style: normal; white-space: nowrap; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
.btn { display: inline-block; padding: 12px 22px; border-radius: var(--radius); border: 2px solid var(--ink); background: transparent; color: var(--ink); font: 500 1rem "IBM Plex Sans", sans-serif; text-decoration: none; cursor: pointer; }
.btn:hover { background: var(--ink); color: #fff; }
.btn.primary { background: var(--ink); color: #fff; }
.btn.primary:hover { background: var(--blue); border-color: var(--blue); }
.section { padding: clamp(40px,7vw,80px) 0; border-top: 1px solid var(--grid); }
.section h2 { font-size: clamp(1.8rem,4vw,2.6rem); font-weight: 800; margin-bottom: 26px; letter-spacing: -.02em; }
.about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; max-width: 820px; }
.about-grid p { margin: 0; max-width: 60ch; }
.skills { list-style: none; padding: 0; margin: 30px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
.skills li { padding: 6px 14px; border: 1.5px solid var(--ink); border-radius: 999px; background: var(--card); font-weight: 500; font-size: .95rem; }
.projects { display: flex; flex-direction: column; gap: 18px; }
.project { background: var(--card); border: 2px solid var(--ink); border-radius: var(--radius); padding: 24px; box-shadow: 6px 6px 0 var(--ink); }
.project h3 { font-size: 1.4rem; font-weight: 800; margin-bottom: 8px; }
.project p { margin: 0 0 14px; max-width: 70ch; color: var(--muted); }
.tags { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 0 0 14px; }
.tags li { background: var(--paper); padding: 2px 10px; border-radius: 4px; font-size: .85rem; border: 1px solid var(--grid); }
.project-links { display: flex; gap: 18px; font-weight: 500; }
.contact-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 36px; align-items: start; }
.contact-grid > p { margin: 0; max-width: 40ch; }
form { display: grid; gap: 16px; }
label { display: grid; gap: 6px; font-weight: 500; }
input, textarea { font: inherit; padding: 11px 12px; border: 2px solid var(--ink); border-radius: var(--radius); background: #fff; color: var(--ink); }
form .btn { justify-self: start; }
.status { margin: 0; color: var(--muted); }
.status.error { color: #b3261e; }
.status.ok { color: #1b6e3c; }
.links { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 34px; font-weight: 500; }
.footer { text-align: center; padding: 30px 20px 50px; color: var(--muted); border-top: 1px solid var(--grid); }
@media (max-width: 720px) { .about-grid, .contact-grid { grid-template-columns: 1fr; } .dimension em { font-size: .8rem; } }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .hero h1 { animation: none; background-size: 100% 100%; } }
